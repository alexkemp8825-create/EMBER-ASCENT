[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/map/MapScreen.gd" id="1_map_screen"]
[ext_resource type="Script" path="res://scripts/map/TowerMapCanvas.gd" id="2_tower_map_canvas"]

[node name="MapScreen" type="PanelContainer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_map_screen")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 32

[node name="Content" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
text = "The Living Tower"
horizontal_alignment = 1

[node name="StatsLabel" type="Label" parent="MarginContainer/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "HP: 0/0  |  Gold: 0  |  Floor: 0"
horizontal_alignment = 1

[node name="TowerMapScroll" type="ScrollContainer" parent="MarginContainer/Content"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="TowerMapCanvas" type="Control" parent="MarginContainer/Content/TowerMapScroll"]
unique_name_in_owner = true
custom_minimum_size = Vector2(800, 960)
layout_mode = 2
size_flags_horizontal = 4
script = ExtResource("2_tower_map_canvas")

[node name="StatusLabel" type="Label" parent="MarginContainer/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Choose your next room."
horizontal_alignment = 1
